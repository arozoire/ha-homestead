{
  "config": {
    "step": {
      "user": {
        "title": "HA Homestead",
        "description": "Manage your garden, orchard and homestead. Location and currency are taken from Home Assistant settings."
      }
    },
    "abort": {
      "single_instance_allowed": "HA Homestead is already configured."
    }
  },
  "entity": {
    "sensor": {
      "plantings": {
        "name": "Plantings"
      },
      "expenses_year": {
        "name": "Expenses this year"
      },
      "tools_needing_service": {
        "name": "Tools needing service"
      }
    }
  },
  "exceptions": {
