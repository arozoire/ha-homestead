  "options": {
    "step": {
      "init": {
        "title": "Weather for the diary",
        "description": "Each diary event records the weather of the week before it (and of the 3 days after for treatments and sowings). Choose your sensors; anything missing comes from Open-Meteo (free, no account). Reminders: planned activities due today are sent to the chosen phones at the chosen time; tapping one opens the diary form already filled in. Alerts: frost below each plant's hardiness, heatwave (hot days and warm nights for some days in a row, when plants no longer recover at night), extreme heat. The forecast comes from the chosen weather entity, else from Open-Meteo.",
        "data": {
          "temperature_sensor": "Outdoor temperature",
          "humidity_sensor": "Outdoor humidity",
          "rain_sensor": "Rain (total, mm)",
          "soil_moisture_sensor": "Soil moisture",
          "open_meteo": "Use Open-Meteo for missing data",
          "notify_services": "Send reminders to",
          "notify_time": "Reminder time",
          "weather_entity": "Weather forecast (HA weather entity)",
          "alert_notify": "Frost and heat alerts on the phones",
          "heat_max": "Heatwave: maximum from",
          "heat_night": "Heatwave: night minimum from",
          "heat_days": "Heatwave: days in a row",
          "heat_extreme": "Extreme heat: maximum from (a single day)"
        }
      }
    }
  },
